generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RESIDENT
  GUARD
}

enum ResidentRelation {
  OWNER
  TENANT
}

enum UnitStatus {
  OCCUPIED
  VACANT
}

enum ChargeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  OTHER
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ---- Auth.js ----
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Dominio ----
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(RESIDENT)
  phone        String?
  image        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts             Account[]
  sessions             Session[]
  resident             Resident?
  reservations         Reservation[]
  ticketsCreated       MaintenanceTicket[] @relation("TicketCreatedBy")
  ticketComments       TicketComment[]
  announcementsWritten Announcement[]      @relation("AnnouncementAuthor")
  paymentsRegistered   Payment[]           @relation("PaymentRegisteredBy")
  visitorsRegistered   Visitor[]           @relation("VisitorRegisteredBy")
}

model Unit {
  id           String     @id @default(cuid())
  code         String     @unique
  building     String?
  floor        Int?
  type         String?
  areaM2       Float?
  parkingSpots Int        @default(0)
  status       UnitStatus @default(OCCUPIED)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  residents    Resident[]
  vehicles     Vehicle[]
  charges      Charge[]
  reservations Reservation[]
  tickets      MaintenanceTicket[]
  visitors     Visitor[]
}

model Resident {
  id        String           @id @default(cuid())
  unitId    String
  unit      Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId    String?          @unique
  user      User?            @relation(fields: [userId], references: [id])
  fullName  String
  email     String?
  phone     String?
  relation  ResidentRelation @default(OWNER)
  isPrimary Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([unitId])
}

model Vehicle {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  plate       String   @unique
  brand       String?
  model       String?
  color       String?
  parkingSpot String?
  createdAt   DateTime @default(now())
}

model Charge {
  id          String       @id @default(cuid())
  unitId      String
  unit        Unit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  concept     String
  amountCents Int
  period      String
  dueDate     DateTime
  status      ChargeStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payments Payment[]

  @@index([unitId, period])
}

model Payment {
  id             String        @id @default(cuid())
  chargeId       String
  charge         Charge        @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  amountCents    Int
  method         PaymentMethod @default(CASH)
  reference      String?
  notes          String?
  paidAt         DateTime      @default(now())
  registeredById String
  registeredBy   User          @relation("PaymentRegisteredBy", fields: [registeredById], references: [id])
  createdAt      DateTime      @default(now())
}

model CommonArea {
  id               String   @id @default(cuid())
  name             String
  description      String?
  capacity         Int?
  imageUrl         String?
  openTime         String   @default("08:00")
  closeTime        String   @default("22:00")
  slotMinutes      Int      @default(60)
  requiresApproval Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  reservations Reservation[]
}

model Reservation {
  id           String             @id @default(cuid())
  commonAreaId String
  commonArea   CommonArea         @relation(fields: [commonAreaId], references: [id], onDelete: Cascade)
  unitId       String
  unit         Unit               @relation(fields: [unitId], references: [id], onDelete: Cascade)
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  startTime    DateTime
  endTime      DateTime
  status       ReservationStatus  @default(CONFIRMED)
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([commonAreaId, startTime, endTime])
}

model MaintenanceTicket {
  id          String         @id @default(cuid())
  unitId      String?
  unit        Unit?          @relation(fields: [unitId], references: [id])
  createdById String
  createdBy   User           @relation("TicketCreatedBy", fields: [createdById], references: [id])
  title       String
  description String
  category    String?
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  assignedTo  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  comments TicketComment[]
}

model TicketComment {
  id        String            @id @default(cuid())
  ticketId  String
  ticket    MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User              @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime          @default(now())
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  authorId    String
  author      User      @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  isPinned    Boolean   @default(false)
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Visitor {
  id             String    @id @default(cuid())
  fullName       String
  documentId     String?
  reason         String?
  unitId         String?
  unit           Unit?     @relation(fields: [unitId], references: [id])
  hostName       String?
  vehiclePlate   String?
  registeredById String
  registeredBy   User      @relation("VisitorRegisteredBy", fields: [registeredById], references: [id])
  checkInAt      DateTime  @default(now())
  checkOutAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([checkOutAt])
}

model CondoSettings {
  id        String @id @default(cuid())
  name      String @default("Mi Condominio")
  address   String?
  logoUrl   String?
  currency  String @default("USD")
  feeDueDay Int    @default(5)
}
